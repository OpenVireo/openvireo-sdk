{
  "name": "openvireo-sdk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/connect",
    "packages/cli",
    "packages/github-action"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run docs:check",
    "test": "npm run test --workspaces --if-present",
    "docs:check": "node scripts/check-doc-samples.mjs",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsup": "8.5.0",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
