{
  "name": "@openvireo/cli",
  "version": "0.2.0",
  "description": "openvireo: read, inject and rotate OpenVireo vault secrets with a service account or a user login",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenVireo/openvireo-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/OpenVireo/openvireo-sdk/tree/develop/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/OpenVireo/openvireo-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ov": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsup",
    "build:binary": "npm run build --prefix ../.. -w @openvireo/sdk -w @openvireo/connect && bun build --compile --minify --sourcemap src/bin.ts --outfile dist/ov",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@openvireo/connect": "0.2.0",
    "@openvireo/sdk": "0.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
