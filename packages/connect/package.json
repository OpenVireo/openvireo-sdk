{
  "name": "@openvireo/connect",
  "version": "0.3.0",
  "description": "openvireo connect: a self-hosted REST server that holds one OpenVireo service account token",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenVireo/openvireo-sdk.git",
    "directory": "packages/connect"
  },
  "homepage": "https://github.com/OpenVireo/openvireo-sdk/tree/develop/packages/connect#readme",
  "bugs": {
    "url": "https://github.com/OpenVireo/openvireo-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "openvireo-connect": "./dist/bin.js"
  },
  "files": [
    "dist",
    "deploy",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openvireo/sdk": "0.3.0"
  }
}
