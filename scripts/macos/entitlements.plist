<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime denies JavaScriptCore's JIT without this; the binary still runs, but only in the
	     interpreter, several times slower (OPAQUE login in the smoke test: 1.3 s with it, 5.9 s without). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
